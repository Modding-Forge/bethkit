+function BethkitTryGetArgumentValue(
+  const aArgument: string;
+  out aValue: string
+): Boolean;
+var
+  lIndex: Integer;
+begin
+  Result := False;
+  aValue := '';
+  for lIndex := 1 to Pred(ParamCount) do
+    if SameText(ParamStr(lIndex), aArgument) then begin
+      aValue := ParamStr(Succ(lIndex));
+      Exit(True);
+    end;
+end;
+
+function BethkitTryGameMode(
+  const aGame: string;
+  out aGameMode: TwbGameMode
+): Boolean;
+begin
+  Result := True;
+  if SameText(aGame, 'skyrim_le') then
+    aGameMode := gmTES5
+  else if SameText(aGame, 'skyrim_se') then
+    aGameMode := gmSSE
+  else if SameText(aGame, 'skyrim_vr') then
+    aGameMode := gmTES5VR
+  else if SameText(aGame, 'fallout_3') then
+    aGameMode := gmFO3
+  else if SameText(aGame, 'fallout_nv') then
+    aGameMode := gmFNV
+  else if SameText(aGame, 'fallout_4') then
+    aGameMode := gmFO4
+  else if SameText(aGame, 'fallout_4_vr') then
+    aGameMode := gmFO4VR
+  else if SameText(aGame, 'fallout_76') then
+    aGameMode := gmFO76
+  else if SameText(aGame, 'oblivion') then
+    aGameMode := gmTES4
+  else if SameText(aGame, 'morrowind') then
+    aGameMode := gmTES3
+  else if SameText(aGame, 'starfield') then
+    aGameMode := gmSF1
+  else
+    Result := False;
+end;
