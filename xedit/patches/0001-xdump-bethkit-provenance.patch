 {$SetPEFlags IMAGE_FILE_LARGE_ADDRESS_AWARE}
 
 var
@@ -86,6 +89,43 @@ begin
     WriteLn(ErrOutput, FormatDateTime('<hh:nn:ss.zzz>', Now - StartTime), ' ', aStatus);
 end;
 
+function BethkitHasExactArgument(const aArgument: string): Boolean;
+var
+  lIndex: Integer;
+begin
+  Result := False;
+  for lIndex := 1 to ParamCount do
+    if SameText(ParamStr(lIndex), aArgument) then
+      Exit(True);
+end;
+
+procedure BethkitWriteProvenance;
+var
+  lExecutableHash: string;
+  lMapHash: string;
+begin
+  lExecutableHash := LowerCase(
+    THashSHA2.GetHashStringFromFile(ParamStr(0), THashSHA2.TSHA2Version.SHA256)
+  );
+  lMapHash := LowerCase(
+    THashSHA2.GetHashStringFromFile(
+      ChangeFileExt(ParamStr(0), '.map'),
+      THashSHA2.TSHA2Version.SHA256
+    )
+  );
+  WriteLn(
+    '{"source_tag":"', BETHKIT_XEDIT_SOURCE_TAG,
+    '","source_commit":"', BETHKIT_XEDIT_SOURCE_COMMIT,
+    '","source_archive_sha256":"', BETHKIT_XEDIT_SOURCE_ARCHIVE_SHA256,
+    '","exporter_version":"', BETHKIT_EXPORTER_VERSION,
+    '","exporter_binary_sha256":"', lExecutableHash,
+    '","exporter_map_sha256":"', lMapHash,
+    '","exporter_patch_sha256":"', BETHKIT_EXPORTER_PATCH_SHA256,
+    '","exporter_build_sha256":"', BETHKIT_EXPORTER_BUILD_SHA256,
+    '"}'
+  );
+end;
+
 type
   TExportFormat = (efUESPWiki, efRaw);
   TwbDefProfile = string;
